    "runnerConformanceExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_schema_ref",
        "result_validation_policy",
        "expected_runner_state",
        "required_isolation_binding_state",
        "pre_spawn_expectation",
        "expected_reason_ids",
        "reason_match_policy",
        "required_evidence_ids",
        "evidence_match_policy",
        "forbidden_result_members",
        "assertion_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "RunnerConformanceExpected.v1"
        },
        "result_schema_ref": {
          "const": "https://raw.githubusercontent.com/rain-123-bow/aegis/main/schemas/aegis/v2/runner_conformance_result.v1.schema.json"
        },
        "result_validation_policy": {
          "const": "VALIDATE_FULL_RESULT_SCHEMA_AND_SELF_HASH_BEFORE_EXPECTED_TEMPLATE"
        },
        "expected_runner_state": {
          "type": "string",
          "enum": [
            "BLOCKED_INVALID_RUNNER_INPUT",
            "BLOCKED_INVALID_RUNNER_CONTRACT",
            "BLOCKED_UNSUPPORTED_PLATFORM",
            "BLOCKED_INVALID_PYTHON_BINDING",
            "BLOCKED_FIXTURE_PREPARATION",
            "BLOCKED_UNVERIFIED_ISOLATION"
          ]
        },
        "required_isolation_binding_state": {
          "type": "string",
          "enum": [
            "UNVERIFIED_ISOLATION",
            "NOT_APPLICABLE"
          ]
        },
        "pre_spawn_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spawn_attempted",
            "comparison_performed",
            "pass_eligible",
            "output_artifact_raw_sha256"
          ],
          "properties": {
            "spawn_attempted": {
              "const": false
            },
            "comparison_performed": {
              "const": false
            },
            "pass_eligible": {
              "const": false
            },
            "output_artifact_raw_sha256": {
              "type": "null"
            }
          }
        },
        "expected_reason_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/stableId"
          }
        },
        "reason_match_policy": {
          "const": "EXACT_ARRAY_ORDER"
        },
        "required_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/contentId"
          }
        },
        "evidence_match_policy": {
          "const": "REQUIRED_SUBSET_ALLOW_RUNTIME_ADDITIONS"
        },
        "forbidden_result_members": {
          "const": [
            "evaluation_runner_output",
            "execution_failure",
            "execution_record",
            "pre_spawn_block",
            "python_executable_binding_id",
            "runner_execution_record_id",
            "runner_input_jcs_sha256",
            "runner_output_sha256",
            "sut_decision",
            "sut_decision_sha256",
            "sut_input_jcs_sha256",
            "sut_output_schema_id"
          ]
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/stableId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_runner_state": {
                "const": "BLOCKED_UNVERIFIED_ISOLATION"
              }
            },
            "required": [
              "expected_runner_state"
            ]
          },
          "then": {
            "properties": {
              "required_isolation_binding_state": {
                "const": "UNVERIFIED_ISOLATION"
              }
            }
          },
          "else": {
            "properties": {
              "required_isolation_binding_state": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      ]
    },
