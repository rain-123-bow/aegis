{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rain-123-bow/aegis/main/schemas/aegis/v2/sut_decision.v1.schema.json",
  "title": "SutDecision.v1",
  "description": "Strict, context-free decision emitted by the system under test on stdout.",
  "$comment": "sut_decision_sha256 is SHA-256 over the UTF-8 JCS RFC 8785 bytes of this object with sut_decision_sha256 omitted. This object intentionally has no case_id, runner_contract_id, input_binding_id, expected value, oracle, runtime binding, execution record, or comparator result. The SUT receives only the five-member projection declared by EvaluationRunnerContract.v1 and must derive this decision without case identity or expected-label access. reason_ids and assertion_ids are unique and ordered by the frozen SUT rule; JSON Schema enforces uniqueness while the evaluator enforces ordering and the self-hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "decision",
    "reason_ids",
    "assertion_ids",
    "sut_decision_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "SutDecision.v1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REJECT",
        "ROUTE",
        "TERMINAL",
        "UNVERIFIED"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "graph_decision.v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "$ref": "common.v1.schema.json#/$defs/graphDecisionReasonId"
          },
          {
            "$ref": "common.v1.schema.json#/$defs/stableId"
          }
        ]
      }
    },
    "assertion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/stableId"
      }
    },
    "sut_decision_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ROUTE"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "ROUTE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "TERMINAL"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "TERMINAL"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "UNVERIFIED"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "type": "null"
          }
        }
      }
    }
  ]
}
