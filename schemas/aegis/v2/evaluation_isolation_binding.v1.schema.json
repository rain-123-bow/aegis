{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rain-123-bow/aegis/main/schemas/aegis/v2/evaluation_isolation_binding.v1.schema.json",
  "title": "EvaluationIsolationBinding.v1",
  "description": "Machine-specific binding of a certified execution-isolation backend or an honest pre-execution isolation block.",
  "$comment": "binding_id is sha256:<SHA-256(UTF-8 JCS RFC 8785 bytes of this object with binding_id omitted)>. VERIFIED_RELEASE_GRADE authorizes process creation only after the evaluator loads an independently preauthorized CertificationTrustAnchor.v1, verifies its authorization event/artifact/current revocation state, then verifies the backend certificate signature/scope/validity, backend binary, exact mount table, four required read-denial probes, default filesystem denial, and network denial. Evaluator-created, SUT-created, self-signed, unknown, expired, or revoked anchors fail closed. UNVERIFIED_ISOLATION forbids process creation and can never satisfy a passing case. JSON Schema enforces the closed shape; the evaluator verifies hashes, signatures, path containment/non-aliasing, probe targets, and cross-field identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "evaluation_execution_id",
    "runner_contract_id",
    "isolation_policy_sha256",
    "state",
    "execution_authorized",
    "backend",
    "certification",
    "mounts",
    "deny_evidence",
    "network_evidence",
    "failure_reasons",
    "checked_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "EvaluationIsolationBinding.v1"
    },
    "binding_id": {
      "$ref": "common.v1.schema.json#/$defs/contentId"
    },
    "evaluation_execution_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV7"
    },
    "runner_contract_id": {
      "$ref": "common.v1.schema.json#/$defs/contentId"
    },
    "isolation_policy_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "state": {
      "type": "string",
      "enum": [
        "VERIFIED_RELEASE_GRADE",
        "UNVERIFIED_ISOLATION"
      ]
    },
    "execution_authorized": {
      "type": "boolean"
    },
    "backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/backend"
        },
        {
          "type": "null"
        }
      ]
    },
    "certification": {
      "anyOf": [
        {
          "$ref": "#/$defs/certification"
        },
        {
          "type": "null"
        }
      ]
    },
    "mounts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/mount"
      }
    },
    "deny_evidence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/denyEvidence"
      }
    },
    "network_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/networkEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "NO_CERTIFIED_BACKEND",
          "TRUST_ANCHOR_MISSING",
          "TRUST_ANCHOR_UNAUTHORIZED",
          "TRUST_ANCHOR_REVOKED",
          "CERTIFICATION_INVALID",
          "CERTIFICATION_EXPIRED",
          "BACKEND_BINARY_MISMATCH",
          "MOUNT_POLICY_MISMATCH",
          "FILESYSTEM_DENIAL_NOT_PROVEN",
          "NETWORK_DENIAL_NOT_PROVEN",
          "PATH_ALIAS_OR_CONTAINMENT_UNPROVEN"
        ]
      }
    },
    "checked_at_utc": {
      "$ref": "common.v1.schema.json#/$defs/utcDateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "VERIFIED_RELEASE_GRADE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "execution_authorized": {
            "const": true
          },
          "backend": {
            "$ref": "#/$defs/backend"
          },
          "certification": {
            "$ref": "#/$defs/certification"
          },
          "mounts": {
            "$ref": "#/$defs/verifiedMounts"
          },
          "deny_evidence": {
            "$ref": "#/$defs/verifiedDenyEvidence"
          },
          "network_evidence": {
            "$ref": "#/$defs/networkEvidence"
          },
          "failure_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "execution_authorized": {
            "const": false
          },
          "backend": {
            "type": "null"
          },
          "certification": {
            "type": "null"
          },
          "mounts": {
            "type": "array",
            "maxItems": 0
          },
          "deny_evidence": {
            "type": "array",
            "maxItems": 0
          },
          "network_evidence": {
            "type": "null"
          },
          "failure_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "portableAbsolutePath": {
      "oneOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/sourceHostAbsolutePath"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000\\r\\n])(?:[^/]+(?:/[^/]+)*)?$"
        }
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "backend_version",
        "enforcement_kind",
        "binary_realpath",
        "binary_byte_size",
        "binary_raw_sha256",
        "default_filesystem_access",
        "network_enforcement",
        "same_user_bypass_resistance"
      ],
      "properties": {
        "backend_id": {
          "$ref": "common.v1.schema.json#/$defs/stableId"
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "enforcement_kind": {
          "type": "string",
          "enum": [
            "OS_SANDBOX",
            "APPLICATION_CONTAINER",
            "HARDWARE_VIRTUAL_MACHINE"
          ]
        },
        "binary_realpath": {
          "$ref": "#/$defs/portableAbsolutePath"
        },
        "binary_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "binary_raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "default_filesystem_access": {
          "const": "DENIED"
        },
        "network_enforcement": {
          "const": "DENIED_AT_BACKEND"
        },
        "same_user_bypass_resistance": {
          "const": "CERTIFIED"
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_id",
        "issuer_id",
        "trust_anchor_id",
        "trust_anchor",
        "trust_anchor_authorization_verified",
        "trust_anchor_revocation_check",
        "backend_id",
        "backend_version",
        "isolation_policy_sha256",
        "platform_descriptor_id",
        "validation_suite_sha256",
        "valid_from_utc",
        "valid_until_utc",
        "certificate_path",
        "certificate_byte_size",
        "certificate_raw_sha256",
        "signed_payload_jcs_sha256",
        "signature_algorithm",
        "signature_base64",
        "trust_result"
      ],
      "properties": {
        "certification_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "issuer_id": {
          "$ref": "common.v1.schema.json#/$defs/stableId"
        },
        "trust_anchor_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "trust_anchor": {
          "$ref": "certification_trust_anchor.v1.schema.json"
        },
        "trust_anchor_authorization_verified": {
          "const": true
        },
        "trust_anchor_revocation_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry_id",
            "registry_snapshot_id",
            "registry_artifact",
            "registry_record_raw_sha256",
            "state",
            "revoked_at_utc",
            "checked_at_utc"
          ],
          "properties": {
            "registry_id": {
              "$ref": "common.v1.schema.json#/$defs/stableId"
            },
            "registry_snapshot_id": {
              "$ref": "common.v1.schema.json#/$defs/contentId"
            },
            "registry_artifact": {
              "$ref": "common.v1.schema.json#/$defs/artifactReference"
            },
            "registry_record_raw_sha256": {
              "$ref": "common.v1.schema.json#/$defs/sha256"
            },
            "state": {
              "const": "NOT_REVOKED"
            },
            "revoked_at_utc": {
              "type": "null"
            },
            "checked_at_utc": {
              "$ref": "common.v1.schema.json#/$defs/utcDateTime"
            }
          }
        },
        "backend_id": {
          "$ref": "common.v1.schema.json#/$defs/stableId"
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isolation_policy_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "platform_descriptor_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "validation_suite_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "valid_from_utc": {
          "$ref": "common.v1.schema.json#/$defs/utcDateTime"
        },
        "valid_until_utc": {
          "$ref": "common.v1.schema.json#/$defs/utcDateTime"
        },
        "certificate_path": {
          "$ref": "#/$defs/portableAbsolutePath"
        },
        "certificate_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "certificate_raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "signed_payload_jcs_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "signature_algorithm": {
          "const": "ED25519"
        },
        "signature_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        },
        "trust_result": {
          "const": "VALID_TRUSTED_UNEXPIRED_EXACT_PLATFORM"
        }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "host_realpath",
        "sandbox_path",
        "access",
        "content_manifest_sha256"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "enum": [
            "INSTALLED_VIRTUAL_ENVIRONMENT",
            "CURRENT_CASE_DECLARED_FIXTURES",
            "INVOCATION_OUTBOX"
          ]
        },
        "host_realpath": {
          "$ref": "#/$defs/portableAbsolutePath"
        },
        "sandbox_path": {
          "$ref": "#/$defs/portableAbsolutePath"
        },
        "access": {
          "type": "string",
          "enum": [
            "READ_EXECUTE",
            "READ_ONLY",
            "WRITE_ONLY_CREATE_NEW"
          ]
        },
        "content_manifest_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "verifiedMounts": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "INSTALLED_VIRTUAL_ENVIRONMENT"
            },
            "access": {
              "const": "READ_EXECUTE"
            }
          },
          "required": [
            "resource",
            "access"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "CURRENT_CASE_DECLARED_FIXTURES"
            },
            "access": {
              "const": "READ_ONLY"
            }
          },
          "required": [
            "resource",
            "access"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "INVOCATION_OUTBOX"
            },
            "access": {
              "const": "WRITE_ONLY_CREATE_NEW"
            }
          },
          "required": [
            "resource",
            "access"
          ]
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "denyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "probe_operation",
        "target_identity_sha256",
        "blocked",
        "observed_error_code",
        "evidence_raw_sha256"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "enum": [
            "REPOSITORY_ROOT",
            "EVALUATION_CORPUS",
            "EXPECTED_DATA",
            "REFERENCE_SOURCES"
          ]
        },
        "probe_operation": {
          "const": "OPEN_EXISTING_FOR_READ"
        },
        "target_identity_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "blocked": {
          "const": true
        },
        "observed_error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "verifiedDenyEvidence": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "REPOSITORY_ROOT"
            }
          },
          "required": [
            "resource"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "EVALUATION_CORPUS"
            }
          },
          "required": [
            "resource"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "EXPECTED_DATA"
            }
          },
          "required": [
            "resource"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "const": "REFERENCE_SOURCES"
            }
          },
          "required": [
            "resource"
          ]
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "networkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_set_id",
        "address_families",
        "operations",
        "all_blocked",
        "evidence_raw_sha256"
      ],
      "properties": {
        "probe_set_id": {
          "$ref": "common.v1.schema.json#/$defs/stableId"
        },
        "address_families": {
          "const": [
            "IPV4",
            "IPV6"
          ]
        },
        "operations": {
          "const": [
            "CREATE_SOCKET",
            "CONNECT_LOOPBACK",
            "CONNECT_EXTERNAL",
            "DNS_RESOLUTION"
          ]
        },
        "all_blocked": {
          "const": true
        },
        "evidence_raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
