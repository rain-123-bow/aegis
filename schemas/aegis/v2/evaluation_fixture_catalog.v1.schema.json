{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rain-123-bow/aegis/main/schemas/aegis/v2/evaluation_fixture_catalog.v1.schema.json",
  "title": "EvaluationFixtureCatalog.v1",
  "description": "Portable exact-byte mapping from logical Windows runtime paths to immutable repository fixtures.",
  "$comment": "catalog_sha256 is SHA-256 over UTF-8 JCS RFC8785 bytes of this object with catalog_sha256 omitted. fixtures are sorted by fixture_id and IDs, repository paths, and each logical path are unique. The gate reads Git blob bytes, verifies size/raw_sha256 plus optional JCS hash, then materializes exact bytes without overwrite and verifies both source and destination. SYNTHETIC_OFFLINE fixtures can exercise the corpus but can never satisfy a live Phase 0B capability gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_kind",
    "canonicalization",
    "byte_contract",
    "fixtures",
    "catalog_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "EvaluationFixtureCatalog.v1"
    },
    "catalog_kind": {
      "const": "EVALUATION_FIXTURE_CATALOG"
    },
    "canonicalization": {
      "const": "JCS-RFC8785"
    },
    "byte_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_bytes",
        "materialized_bytes"
      ],
      "properties": {
        "repository_bytes": {
          "const": "GIT_BLOB_BYTES"
        },
        "materialized_bytes": {
          "const": "EXACT_REPOSITORY_BLOB_BYTES"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "catalog_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "logical_runtime_paths",
        "repository_path",
        "artifact_kind",
        "provenance_class",
        "byte_domain",
        "media_type",
        "encoding",
        "byte_order_mark",
        "line_ending",
        "byte_size",
        "raw_sha256",
        "jcs_sha256",
        "materialization",
        "eligible_for_live_capability_pass",
        "case_ids"
      ],
      "properties": {
        "fixture_id": {
          "$ref": "common.v1.schema.json#/$defs/stableId"
        },
        "logical_runtime_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/runtimeAbsolutePath"
          }
        },
        "repository_path": {
          "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "DISPATCH_PAYLOAD",
            "CODEX_AUTHORITY_RAW_RECORD",
            "CHILD_OUTBOX_RESULT",
            "REFERENCE_TRACE",
            "SUT_INPUT",
            "SUT_OUTPUT"
          ]
        },
        "provenance_class": {
          "const": "SYNTHETIC_OFFLINE"
        },
        "byte_domain": {
          "const": "EXACT_REPOSITORY_BLOB_BYTES"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "application/json",
            "text/plain; charset=utf-8"
          ]
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byte_order_mark": {
          "const": "ABSENT"
        },
        "line_ending": {
          "type": "string",
          "enum": [
            "LF",
            "NONE"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "jcs_sha256": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "access_mode",
            "overwrite",
            "verify_before",
            "verify_after"
          ],
          "properties": {
            "mode": {
              "const": "COPY_EXACT_BYTES"
            },
            "access_mode": {
              "const": "READ_ONLY"
            },
            "overwrite": {
              "const": "FORBIDDEN"
            },
            "verify_before": {
              "const": true
            },
            "verify_after": {
              "const": true
            }
          }
        },
        "eligible_for_live_capability_pass": {
          "const": false
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/caseId"
          }
        }
      }
    }
  }
}
