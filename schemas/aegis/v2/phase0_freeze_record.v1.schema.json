{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rain-123-bow/aegis/main/schemas/aegis/v2/phase0_freeze_record.v1.schema.json",
  "title": "Phase0FreezeRecord.v1",
  "description": "Content-addressed Phase 0A freeze root, code-absence proof, independent review, and append-only authority anchor.",
  "$comment": "freeze_record_id is sha256:<SHA-256(UTF-8 JCS RFC8785 bytes of this object with freeze_record_id omitted)>. Each freeze input leaf is independently recomputed from its declared byte domain and repository or external acquisition locator. freeze_root_id is sha256:<SHA-256(JCS of the sorted array of {logical_path,leaf_sha256})>; review and authority records are deliberately outside that root to avoid a hash cycle. A production FROZEN record additionally requires a concrete independently verifiable provider proof. No such adapter or proof format is implemented in current Phase 0A; therefore schema validity is structural only and public finalize/verify plus the offline repository validator must reject every FROZEN record as AUTHORITY_UNVERIFIED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_record_id",
    "freeze_state",
    "canonicalization",
    "freeze_base_commit",
    "freeze_base_tree",
    "freeze_time_utc",
    "freeze_inputs",
    "freeze_root_id",
    "code_absence_proof",
    "freeze_producer_identity",
    "review_anchor",
    "authority_anchor",
    "implementation_order_constraint"
  ],
  "properties": {
    "schema_version": {
      "const": "Phase0FreezeRecord.v1"
    },
    "freeze_record_id": {
      "$ref": "common.v1.schema.json#/$defs/contentId"
    },
    "freeze_state": {
      "const": "FROZEN_REVIEWED_ANCHORED"
    },
    "canonicalization": {
      "const": "JCS-RFC8785"
    },
    "freeze_base_commit": {
      "$ref": "common.v1.schema.json#/$defs/gitObjectId"
    },
    "freeze_base_tree": {
      "$ref": "common.v1.schema.json#/$defs/gitObjectId"
    },
    "freeze_time_utc": {
      "$ref": "common.v1.schema.json#/$defs/utcDateTime"
    },
    "freeze_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/freezeInput"
      }
    },
    "freeze_root_id": {
      "$ref": "common.v1.schema.json#/$defs/contentId"
    },
    "code_absence_proof": {
      "$ref": "#/$defs/codeAbsenceProof"
    },
    "freeze_producer_identity": {
      "$ref": "#/$defs/freezeProducerIdentity"
    },
    "review_anchor": {
      "$ref": "#/$defs/reviewAnchor"
    },
    "authority_anchor": {
      "$ref": "#/$defs/authorityAnchor"
    },
    "implementation_order_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "required_ancestry",
        "required_freeze_root_preservation"
      ],
      "properties": {
        "policy": {
          "const": "FIRST_IMPLEMENTATION_COMMIT_AFTER_ANCHOR"
        },
        "required_ancestry": {
          "const": "FIRST_IMPLEMENTATION_COMMIT_DESCENDS_FROM_FREEZE_BASE_COMMIT"
        },
        "required_freeze_root_preservation": {
          "const": true
        }
      },
      "$comment": "Before accepting the first implementation commit, the gate verifies Git ancestry, the authoritative anchor timestamp/event order, and that every frozen input still hashes to freeze_root_id. The freeze record itself does not claim that a future commit already exists."
    }
  },
  "$defs": {
    "freezeProducerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_id",
        "session_id",
        "turn_id"
      ],
      "properties": {
        "thread_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "session_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "turn_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        }
      },
      "$comment": "Persisted inside the final record so reviewer independence is portable and does not depend on an unverifiable caller-supplied identity."
    },
    "freezeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "locator",
        "artifact_kind",
        "byte_domain",
        "byte_size",
        "raw_sha256",
        "semantic_jcs_sha256",
        "leaf_sha256"
      ],
      "properties": {
        "logical_path": {
          "type": "string",
          "minLength": 7,
          "maxLength": 4096,
          "pattern": "^(?:repo|external):/[^\\r\\n]+$"
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryLocator"
            },
            {
              "$ref": "#/$defs/externalAcquisitionLocator"
            }
          ]
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "NORMATIVE_CONTRACT",
            "ARCHITECTURE_DECISION",
            "REQUIREMENT_DESIGN",
            "REVIEWED_IMPLEMENTATION_PLAN",
            "STATIC_CAPABILITY_EVIDENCE",
            "VERSIONED_SCHEMA",
            "EVALUATION_MANIFEST",
            "FIXTURE_CATALOG",
            "EVALUATION_FIXTURE",
            "EXCLUSION_RISK_REGISTER",
            "ATTRIBUTE_POLICY",
            "PROJECT_METADATA",
            "PLATFORM_DEPENDENCY_LOCK",
            "EVALUATION_HARNESS",
            "EVALUATION_REFERENCE_SOURCE",
            "EVALUATION_REFERENCE_SOURCE_MANIFEST",
            "COMPARATOR_SPEC"
          ]
        },
        "byte_domain": {
          "type": "string",
          "enum": [
            "GIT_BLOB_BYTES",
            "UTF8_LF_NO_BOM",
            "JCS_RFC8785"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "semantic_jcs_sha256": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "leaf_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      },
      "$comment": "byte_size and raw_sha256 always bind the exact source bytes acquired from locator. byte_domain selects the interpretation and validation rule for those bytes; JCS_RFC8785 additionally requires duplicate-free JSON and a non-null semantic_jcs_sha256 over its RFC 8785 UTF-8 representation. Repository text is required to be UTF-8, BOM-free, and LF-only by the artifact-kind policy. leaf_sha256 hashes the JCS bytes of this input with leaf_sha256 omitted, so both the exact source encoding and the semantic JSON content are frozen. repo:/ logical paths require a repository locator; external:/ logical paths require an independently captured external acquisition locator."
    },
    "repositoryLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository_path"
      ],
      "properties": {
        "kind": {
          "const": "REPOSITORY"
        },
        "repository_path": {
          "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
        }
      }
    },
    "externalAcquisitionLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "absolute_path",
        "acquisition_evidence_id",
        "acquisition_event_id"
      ],
      "properties": {
        "kind": {
          "const": "EXTERNAL_ACQUISITION"
        },
        "absolute_path": {
          "$ref": "common.v1.schema.json#/$defs/sourceHostAbsolutePath"
        },
        "acquisition_evidence_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "acquisition_event_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV7"
        }
      },
      "$comment": "The program gate loads immutable acquisition evidence, verifies source path, byte size/hash, UTC, producer, and capture event, and rejects a current-path read without the acquisition chain."
    },
    "codeAbsenceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code_absence_proof_id",
        "canonicalization",
        "freeze_base_commit",
        "tracked_tree_capture",
        "worktree_inventory_id",
        "worktree_inventory",
        "tracked_entry_count",
        "nonignored_untracked_entry_count",
        "allowed_phase0a_file_domain",
        "outside_domain_entries",
        "prohibited_implementation_classifiers",
        "base_tree_prohibited_matches",
        "worktree_prohibited_matches",
        "proof_event_id",
        "proven_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "CodeAbsenceProof.v1"
        },
        "code_absence_proof_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "canonicalization": {
          "const": "JCS-RFC8785"
        },
        "freeze_base_commit": {
          "$ref": "common.v1.schema.json#/$defs/gitObjectId"
        },
        "tracked_tree_capture": {
          "$ref": "#/$defs/trackedTreeCapture"
        },
        "worktree_inventory_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "worktree_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worktreeInventoryEntry"
          },
          "$comment": "Complete sorted union of every tracked base-tree path and every non-ignored untracked worktree path. Deleted tracked paths remain present as TRACKED_DELETED."
        },
        "tracked_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "nonignored_untracked_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_phase0a_file_domain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
          },
          "$comment": "Exact, fully resolved Phase 0A file set. Directory globs and implicit descendants are forbidden."
        },
        "outside_domain_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outsideDomainEntry"
          }
        },
        "prohibited_implementation_classifiers": {
          "type": "array",
          "const": [
            "AEGIS_V2_KERNEL",
            "RELAY_EXECUTOR",
            "LIVE_CAPABILITY_PROBE",
            "EQUIVALENT_EXECUTABLE_IMPLEMENTATION"
          ]
        },
        "base_tree_prohibited_matches": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/prohibitedImplementationMatch"
          }
        },
        "worktree_prohibited_matches": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/prohibitedImplementationMatch"
          }
        },
        "proof_event_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV7"
        },
        "proven_at_utc": {
          "$ref": "common.v1.schema.json#/$defs/utcDateTime"
        }
      },
      "$comment": "code_absence_proof_id is sha256:<SHA-256(JCS of this object with code_absence_proof_id omitted)>. freeze_base_commit must equal the enclosing freeze record. The gate decodes tracked_tree_capture.raw_stdout_base64, verifies byte size/hash, parses every NUL-delimited base-tree entry, and proves that worktree_inventory is its complete sorted union with all non-ignored untracked paths. worktree_inventory_id is the JCS self-omission hash of that sorted array. tracked_entry_count and nonignored_untracked_entry_count are recomputed. allowed_phase0a_file_domain is an exact sorted path set; outside_domain_entries is the exact complement and each entry binds the corresponding inventory bytes. BASE_EQUAL requires identical base/worktree bytes. PREEXISTING_NON_V2 requires immutable byte bindings, rationale, and an independent disposition artifact. Any missing/unclassified entry or prohibited implementation match fails closed."
    },
    "trackedTreeCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "working_directory",
        "stdout_encoding",
        "raw_stdout_base64",
        "stdout_byte_size",
        "stdout_sha256",
        "required_exit_code",
        "stderr_byte_size",
        "stderr_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "git"
            },
            {
              "const": "ls-tree"
            },
            {
              "const": "-rz"
            },
            {
              "const": "--full-tree"
            },
            {
              "$ref": "common.v1.schema.json#/$defs/gitObjectId"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "working_directory": {
          "const": "REPOSITORY_ROOT"
        },
        "stdout_encoding": {
          "const": "RAW_BYTES_BASE64"
        },
        "raw_stdout_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "stdout_byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "required_exit_code": {
          "const": 0
        },
        "stderr_byte_size": {
          "const": 0
        },
        "stderr_sha256": {
          "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        }
      },
      "$comment": "argv[4] must equal CodeAbsenceProof.freeze_base_commit. Invocation is direct argv without shell interpolation; stdout is retained exactly, including NUL bytes."
    },
    "worktreeInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_entry_id",
        "repository_relative_path",
        "entry_kind",
        "base_bytes",
        "worktree_bytes"
      ],
      "properties": {
        "inventory_entry_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "repository_relative_path": {
          "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
        },
        "entry_kind": {
          "type": "string",
          "enum": [
            "TRACKED_UNCHANGED",
            "TRACKED_MODIFIED",
            "TRACKED_DELETED",
            "UNTRACKED_NONIGNORED"
          ]
        },
        "base_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/frozenBytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/frozenBytes"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entry_kind": {
                "const": "UNTRACKED_NONIGNORED"
              }
            },
            "required": [
              "entry_kind"
            ]
          },
          "then": {
            "properties": {
              "base_bytes": {
                "type": "null"
              },
              "worktree_bytes": {
                "$ref": "#/$defs/frozenBytes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entry_kind": {
                "const": "TRACKED_DELETED"
              }
            },
            "required": [
              "entry_kind"
            ]
          },
          "then": {
            "properties": {
              "base_bytes": {
                "$ref": "#/$defs/frozenBytes"
              },
              "worktree_bytes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entry_kind": {
                "enum": [
                  "TRACKED_UNCHANGED",
                  "TRACKED_MODIFIED"
                ]
              }
            },
            "required": [
              "entry_kind"
            ]
          },
          "then": {
            "properties": {
              "base_bytes": {
                "$ref": "#/$defs/frozenBytes"
              },
              "worktree_bytes": {
                "$ref": "#/$defs/frozenBytes"
              }
            }
          }
        }
      ],
      "$comment": "inventory_entry_id is the JCS self-omission content hash. The gate requires base_bytes.source_kind=GIT_BLOB for every tracked entry and exact equality for TRACKED_UNCHANGED. Worktree bytes may also use GIT_BLOB when the exact bytes were written to the local object database with direct argv equivalent to git hash-object -w --no-filters <path>; this captures content without staging, committing, or applying clean filters. The verifier reads the named blob and recomputes byte_size, raw_sha256, and git_blob_id."
    },
    "frozenBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "byte_size",
        "raw_sha256",
        "git_blob_id",
        "snapshot_locator",
        "acquisition_event_id"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "GIT_BLOB",
            "FROZEN_SNAPSHOT"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "git_blob_id": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/gitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/externalAcquisitionLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "acquisition_event_id": {
          "anyOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/uuidV7"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "GIT_BLOB"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "properties": {
              "git_blob_id": {
                "$ref": "common.v1.schema.json#/$defs/gitObjectId"
              },
              "snapshot_locator": {
                "type": "null"
              },
              "acquisition_event_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "git_blob_id": {
                "type": "null"
              },
              "snapshot_locator": {
                "$ref": "#/$defs/externalAcquisitionLocator"
              },
              "acquisition_event_id": {
                "$ref": "common.v1.schema.json#/$defs/uuidV7"
              }
            }
          }
        }
      ]
    },
    "outsideDomainEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_relative_path",
        "inventory_entry_id",
        "disposition",
        "executable_v2_classification",
        "rationale",
        "reviewer_thread_id",
        "reviewer_session_id",
        "reviewer_turn_id",
        "disposition_artifact_locator",
        "disposition_artifact_byte_size",
        "disposition_artifact_sha256"
      ],
      "properties": {
        "repository_relative_path": {
          "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
        },
        "inventory_entry_id": {
          "$ref": "common.v1.schema.json#/$defs/contentId"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "BASE_EQUAL",
            "PREEXISTING_NON_V2"
          ]
        },
        "executable_v2_classification": {
          "const": "NOT_V2_IMPLEMENTATION"
        },
        "rationale": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyString"
        },
        "reviewer_thread_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "reviewer_session_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "reviewer_turn_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "disposition_artifact_locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryLocator"
            },
            {
              "$ref": "#/$defs/externalAcquisitionLocator"
            }
          ]
        },
        "disposition_artifact_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "disposition_artifact_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      },
      "$comment": "The program gate resolves inventory_entry_id, verifies exact base/worktree byte bindings, requires BASE_EQUAL only for TRACKED_UNCHANGED, and verifies that PREEXISTING_NON_V2 rationale and classification were authored by a reviewer independent of the freeze producer."
    },
    "prohibitedImplementationMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_relative_path",
        "classifier",
        "evidence_sha256"
      ],
      "properties": {
        "repository_relative_path": {
          "$ref": "common.v1.schema.json#/$defs/repositoryRelativePath"
        },
        "classifier": {
          "type": "string",
          "enum": [
            "AEGIS_V2_KERNEL",
            "RELAY_EXECUTOR",
            "LIVE_CAPABILITY_PROBE",
            "EQUIVALENT_EXECUTABLE_IMPLEMENTATION"
          ]
        },
        "evidence_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "reviewAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_outcome",
        "open_blocker_ids",
        "capture_source",
        "authority_source_id",
        "authority_policy_id",
        "authority_event_id",
        "authority_event_sequence",
        "authority_committed_at_utc",
        "codex_cli_version",
        "codex_app_server_protocol_semantic_sha256",
        "reviewer_task_path",
        "parent_thread_id",
        "parent_spawn_tool_call_id",
        "parent_delivery_tool_call_id",
        "reviewer_thread_id",
        "reviewer_session_id",
        "reviewer_turn_id",
        "reviewer_item_id",
        "reviewer_turn_started_at_unix_seconds",
        "reviewer_turn_completed_at_unix_seconds",
        "reviewer_item_started_at_unix_ms",
        "reviewer_item_completed_at_unix_ms",
        "reviewer_turn_status",
        "reviewer_item_type",
        "reviewer_item_phase",
        "delivery_kind",
        "review_artifact",
        "reviewed_freeze_root_id",
        "reviewed_code_absence_proof_id",
        "reviewed_at_utc"
      ],
      "properties": {
        "review_outcome": {
          "const": "PASS"
        },
        "open_blocker_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/stableId"
          }
        },
        "capture_source": {
          "const": "PREAUTHORIZED_APPEND_ONLY_CODEX_EVENT_SOURCE"
        },
        "authority_source_id": {
          "$ref": "common.v1.schema.json#/$defs/opaquePlatformId"
        },
        "authority_policy_id": {
