          "$ref": "#/$defs/authorityLocator"
        },
        "anchor_event_encoding": {
          "const": "UTF8_JCS_RFC8785"
        },
        "anchor_event_preimage": {
          "$ref": "#/$defs/reviewFinalEventPreimage"
        },
        "anchor_event_raw_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "anchor_event_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "anchor_event_raw_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "recorded_at_utc": {
          "$ref": "common.v1.schema.json#/$defs/utcDateTime"
        }
      },
      "$comment": "The locator binds a preauthorized external source and ordered event, the parent spawn/delivery tool calls, reviewer thread/session/turn/final agent-message item, lifecycle times/status/phase, and the exact custom review payload. Schema validity, local app-server/history bytes, a caller callback, an exact-byte echo reader, local hash chain, or opaque attestation never establishes authority. The production gate must independently verify a concrete provider proof against a trust policy outside the candidate; no such adapter exists in Phase 0A, so public finalize/verify and the offline validator fail closed for every FROZEN record."
    },
